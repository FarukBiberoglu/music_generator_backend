generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SubscriptionPlan {
  WEEKLY
  MONTHLY
}

model UserModel {
  id          String            @id @default(cuid())
  firebaseUid String            @unique
  generations MusicGeneration[]
  createdAt   DateTime          @default(now())
  favorites   Favorite[]
  playlists   Playlist[]

  // Kredi ve abonelik: paket bitince krediler sıfırlanır
  creditsRemaining   Int               @default(0)
  subscriptionPlan   SubscriptionPlan?
  subscriptionEndsAt DateTime?

  @@index([firebaseUid])
}

model MusicGeneration {
  id String @id @default(cuid())

  userId String
  user   UserModel @relation(fields: [userId], references: [id])

  prompt        String?
  lyrics        String?
  tags          String[]       @default([])
  seed          BigInt?
  playlistItems PlaylistItem[]

  status       GenerationStatus @default(PENDING)
  errorMessage String?

  favorite Favorite[]

  songs     Song[]
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Song {
  id String @id @default(cuid())

  generationId String
  generation   MusicGeneration @relation(fields: [generationId], references: [id])

  audioUrl    String
  contentType String
  fileName    String?
  fileSize    Int?

  durationSec Int?
  createdAt   DateTime @default(now())
}

model Favorite {
  id           String          @id @default(cuid())
  userId       String
  user         UserModel       @relation(fields: [userId], references: [id])
  generationId String
  generation   MusicGeneration @relation(fields: [generationId], references: [id])
  createdAt    DateTime        @default(now())

  @@unique([userId, generationId])
  @@index([userId])
}

model Playlist {
  id        String         @id @default(cuid())
  userId    String
  user      UserModel      @relation(fields: [userId], references: [id])
  name      String
  items     PlaylistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

model PlaylistItem {
  id           String          @id @default(cuid())
  playlistId   String
  playlist     Playlist        @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  generationId String
  generation   MusicGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  position     Int
  createdAt    DateTime        @default(now())

  @@unique([playlistId, generationId])
  @@index([playlistId])
}
